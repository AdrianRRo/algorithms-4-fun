"\nimport { HeapSortStep, Item } from \"../types/algorithms\";\nimport { StepColors } from \"../types/colors\";\nimport { resetColors, setColors, swap } from \"./common\";\n\ntype HeapMetadata = HeapSortStep[\"metadata\"];\ntype ColorInstruction = { index: number; color: StepColors };\n\nconst cloneItems = (items: Item[]): Item[] =>\n    items.map((item) => ({ value: item.value, color: item.color }));\n\nconst arraysMatch = (left: Item[], right: Item[]): boolean =>\n    left.length === right.length &&\n    left.every(\n        (item, index) =>\n            item.value === right[index].value && item.color === right[index].color,\n    );\n\nconst arraysEqual = (left: number[], right: number[]): boolean =>\n    left.length === right.length && left.every((value, index) => value === right[index]);\n\nconst tuplesEqual = (\n    left?: [number, number],\n    right?: [number, number],\n): boolean => {\n    if (!left && !right) {\n        return true;\n    }\n    if (!left || !right) {\n        return false;\n    }\n    return left[0] === right[0] && left[1] === right[1];\n};\n\nconst metadataEquals = (left?: HeapMetadata, right?: HeapMetadata): boolean => {\n    if (!left && !right) {\n        return true;\n    }\n    if (!left || !right) {\n        return false;\n    }\n    return (\n        left.phase === right.phase &&\n        left.heapSize === right.heapSize &&\n        arraysEqual(left.highlightedIndices ?? [], right.highlightedIndices ?? []) &&\n        left.currentRoot === right.currentRoot &&\n        tuplesEqual(left.swapped, right.swapped) &&\n        left.stage === right.stage &&\n        left.description === right.description\n    );\n};\n\nconst pushStep = (\n    steps: HeapSortStep[],\n    array: Item[],\n    metadata: HeapMetadata,\n): void => {\n    const snapshot = cloneItems(array);\n    const lastStep = steps[steps.length - 1];\n    if (!lastStep || !arraysMatch(lastStep.array, snapshot) || !metadataEquals(lastStep.metadata, metadata)) {\n        steps.push({ array: snapshot, metadata });\n    }\n};\n\nconst highlightNodes = (\n    array: Item[],\n    heapSize: number,\n    instructions: ColorInstruction[],\n): Item[] => {\n    const coloredItems = instructions\n        .filter(({ index }) => index >= 0 && index < array.length)\n        .map(({ index, color }) => ({\n            value: array[index].value,\n            color,\n        }));\n    return setColors(array, coloredItems, heapSize - 1, array.length - 1);\n};\n\nconst heapify = (\n    array: Item[],\n    heapSize: number,\n    rootIndex: number,\n    phase: \"build\" | \"extract\",\n    steps: HeapSortStep[],\n): Item[] => {\n    let working = array;\n    let current = rootIndex;\n\n    while (current < heapSize) {\n        const leftChild = 2 * current + 1;\n        const rightChild = leftChild + 1;\n        let largest = current;\n        const highlighted = [current];\n\n        if (leftChild < heapSize) {\n            highlighted.push(leftChild);\n            if (working[leftChild].value > working[largest].value) {\n                largest = leftChild;\n            }\n        }\n\n        if (rightChild < heapSize) {\n            highlighted.push(rightChild);\n            if (working[rightChild].value > working[largest].value) {\n                largest = rightChild;\n            }\n        }\n\n        working = highlightNodes(\n            working,\n            heapSize,\n            highlighted.map((index) => ({\n                index,\n                color: StepColors.HANDLING,\n            })),\n        );\n\n        pushStep(steps, working, {\n            phase,\n            heapSize,\n            highlightedIndices: highlighted,\n            currentRoot: current,\n        });\n\n        if (largest === current) {\n            working = highlightNodes(working, heapSize, []);\n            pushStep(steps, working, {\n                phase,\n                heapSize,\n                highlightedIndices: [],\n                currentRoot: current,\n            });\n            return working;\n        }\n\n        const next = largest;\n        swap(working, current, next);\n\n        working = highlightNodes(working, heapSize, [\n            { index: current, color: StepColors.SWAP },\n            { index: next, color: StepColors.SWAP },\n        ]);\n\n        pushStep(steps, working, {\n            phase,\n            heapSize,\n            highlightedIndices: [current, next],\n            currentRoot: current,\n            swapped: [current, next],\n        });\n\n        current = next;\n    }\n\n    working = highlightNodes(working, heapSize, []);\n    pushStep(steps, working, {\n        phase,\n        heapSize,\n        highlightedIndices: [],\n        currentRoot: current,\n    });\n    return working;\n};\n\nexport const heapSort = (items: Item[]): HeapSortStep[] => {\n    if (items.length === 0) {\n        return [{ array: [] }];\n    }\n\n    const steps: HeapSortStep[] = [];\n    let working = resetColors(cloneItems(items));\n    const totalSize = working.length;\n\n    pushStep(steps, working, {\n        phase: \"build\",\n        heapSize: totalSize,\n        highlightedIndices: [],\n    });\n\n    for (let index = Math.floor(totalSize / 2) - 1; index >= 0; index -= 1) {\n        working = heapify(working, totalSize, index, \"build\", steps);\n    }\n\n    for (let end = totalSize - 1; end > 0; end -= 1) {\n        swap(working, 0, end);\n\n        working = highlightNodes(working, end, [\n            { index: 0, color: StepColors.SWAP },\n            { index: end, color: StepColors.SWAP },\n        ]);\n\n        pushStep(steps, working, {\n            phase: \"extract\",\n            heapSize: end,\n            highlightedIndices: [0, end],\n            currentRoot: 0,\n            swapped: [0, end],\n        });\n\n        working = heapify(working, end, 0, \"extract\", steps);\n    }\n\n    working = highlightNodes(working, 0, []);\n    pushStep(steps, working, {\n        phase: \"extract\",\n        heapSize: 0,\n        highlightedIndices: [],\n    });\n\n    return steps;\n};\n"